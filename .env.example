# MakeGPT Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Make.com API Configuration
# Get your API token from Make.com: Settings > API
MAKE_API_TOKEN=your-make-api-token-here

# Make.com Configuration
# Find these in your Make.com account
MAKE_TEAM_ID=123456
MAKE_FOLDER_ID=789012

# Make.com Region (eu1, eu2, us1, us2)
# Default: eu1
MAKE_REGION=eu1

# OpenAI Model Configuration (optional)
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# Default: gpt-4
OPENAI_MODEL=gpt-4

# Logging Configuration (optional)
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# RAG Knowledge Base Path (optional)
# Default: ./knowledge_base/blueprints
KNOWLEDGE_BASE_PATH=./knowledge_base/blueprints
